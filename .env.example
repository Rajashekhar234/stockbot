# =============================================================================
# Angel One SmartAPI Credentials  (https://smartapi.angelbroking.com/)
# =============================================================================
ANGEL_API_KEY=your_smartapi_key_here
ANGEL_CLIENT_CODE=YOUR_CLIENT_ID
ANGEL_PASSWORD=your_login_password
ANGEL_TOTP_SECRET=base32_totp_secret_from_angel
ANGEL_MPIN=

# =============================================================================
# Google Gemini API  (https://aistudio.google.com/app/apikey)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# Bot behaviour
# =============================================================================
# PAPER = simulate trades, LIVE = place real orders, ALERT_ONLY = just notify
TRADE_MODE=PAPER

# Capital available for the day (INR) — used only when TRADE_AMOUNT is empty
CAPITAL=20000

# ABSOLUTE rupee amount to deploy per trade (e.g. 30000 = ₹30k of stock).
# If set, this OVERRIDES MAX_POSITION_PCT. Bot calculates qty = floor(TRADE_AMOUNT / ltp).
# Leave empty to fall back to capital * MAX_POSITION_PCT.
TRADE_AMOUNT=30000

# Optional hard cap on quantity (0 = no cap)
MAX_QTY=0

# Position sizing fallback — never invest more than this fraction of capital
MAX_POSITION_PCT=0.80

# Risk parameters
STOP_LOSS_PCT=0.01
TARGET_PCT=0.025
TRAIL_AFTER_PCT=0.015
FORCE_EXIT_TIME=15:00

# Universe filters
MIN_PRICE=100
MAX_PRICE=3000

# Scoring threshold to consider a trade
MIN_SCORE=80

# =============================================================================
# Optional alerting
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated list of Telegram user IDs allowed to send /commands. Required for control.
TELEGRAM_ADMIN_IDS=
ENABLE_SOUND_ALERTS=true
